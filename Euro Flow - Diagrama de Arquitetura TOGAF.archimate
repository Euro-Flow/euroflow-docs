  <folder name="Strategy" id="id-f477fb113e434374b697873b27d771b1" type="strategy"/>
  <folder name="Motivation" id="id-d47d4faf" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Eurofarma" id="id-91f91c4e"/>
    <element xsi:type="archimate:Stakeholder" name="RH / Administrador" id="id-1b32acd6"/>
    <element xsi:type="archimate:Stakeholder" name="Colaborador" id="id-9eef5f5f"/>
    <element xsi:type="archimate:Driver" name="Risco de Não-Conformidade e Falha em Compliance" id="id-c416fa84"/>
    <element xsi:type="archimate:Driver" name="Desengajamento dos colaboradores em treinamentos essenciais" id="id-891e4845"/>
    <element xsi:type="archimate:Driver" name="Processos de Treinamento Manuais e Burocráticos" id="id-0246eecf"/>
    <element xsi:type="archimate:Driver" name="Baixa Retenção de Conhecimento no Onboarding" id="id-a7f2fb02"/>
    <element xsi:type="archimate:Driver" name="Falta centralização de informações úteis para colaboradores" id="id-f43f39b1"/>
    <element xsi:type="archimate:Goal" name="Permitir a gestão dos treinamentos anuais atribuídos de forma digital" id="id-df37e77a"/>
    <element xsi:type="archimate:Goal" name="Garantir conformidade com políticas internas e regulamentações" id="id-9b5632bd"/>
    <element xsi:type="archimate:Goal" name="Gamificar a jornada de onboardin" id="id-99cac4b0"/>
    <element xsi:type="archimate:Goal" name="Disponibilizar acesso a conteúdos e documentos de treinamento/onboarding  de forma digital" id="id-b9e9eeed"/>
    <element xsi:type="archimate:Goal" name="Oferecer gestão eficiente de treinamentos e analytics para RH" id="id-6a7c646e"/>
    <element xsi:type="archimate:Outcome" name="Aumentar a retenção de conhecimento dos colaboradores no período de onboarding" id="id-2b6165c9"/>
    <element xsi:type="archimate:Outcome" id="id-53be6611"/>
    <element xsi:type="archimate:Outcome" name="Aumento das ofensivas diárias (streaks) dos colaboradores" id="id-4b365497"/>
    <element xsi:type="archimate:Outcome" name="Onboarding concluído dentro do prazo definido pelo RH" id="id-9830613b"/>
    <element xsi:type="archimate:Outcome" name="Simplificar o processo de busca de documentos" id="id-2bcdb3fe"/>
    <element xsi:type="archimate:Outcome" name="100% dos colaboradores com acesso autenticado e perfil gerenciado" id="id-bfcfb512"/>
    <element xsi:type="archimate:Assessment" name="App Mobile Nativo Android/Kotlin com Mascote IA Euro (chatbot conversacional)" id="id-59dc530c"/>
    <element xsi:type="archimate:Assessment" name="IA" id="id-79669d47"/>
    <element xsi:type="archimate:Assessment" name="RAG — Busca inteligente sobre documentos PDF indexados no backend" id="id-8dbfb226"/>
    <element xsi:type="archimate:Assessment" name="Console Web Administrativo para RH/Administrador" id="id-0e3a4a06"/>
    <element xsi:type="archimate:Assessment" name="Geração automática de tickets de suporte quando a IA não resolve a dúvida" id="id-f8f309b3"/>
    <element xsi:type="archimate:Requirement" name="RF1 — Autenticação de Usuário (e-mail/senha ou SSO corporativo) [Obrigatório]" id="id-d9b6f5d4"/>
    <element xsi:type="archimate:Requirement" name="RF2 — Dashboard com progresso de trilhas, ofensivas e cards de ação rápida [Necessário]" id="id-82d172a0"/>
    <element xsi:type="archimate:Requirement" name="RF3 — Chat com Mascote Euro — linguagem natural + base de conhecimento [Obrigatório]" id="id-c4bc23b4"/>
    <element xsi:type="archimate:Requirement" name="RF4 — Listagem de Trilhas (Onboarding, Compliance, Técnico) com progresso e prazo [Obrigatório]" id="id-c72b8560"/>
    <element xsi:type="archimate:Requirement" name="RF5 — Acesso Guiado ao Conteúdo — sequência de vídeos, textos e diálogos [Necessário]" id="id-0676863e"/>
    <element xsi:type="archimate:Requirement" name="RF6 — Laboratório de Ideias — envio de sugestões por áudio, transcritas por IA [Opcional]" id="id-1747e151"/>
    <element xsi:type="archimate:Requirement" name="RF7 — Perfil Gamificado — ofensivas (streaks), nome e área do colaborador [Necessário]" id="id-7b584d16"/>
    <element xsi:type="archimate:Requirement" name="RF8 — Biblioteca de Documentos — busca por palavras-chave e leitor PDF interno [Obrigatório]" id="id-fe723238"/>
    <element xsi:type="archimate:Requirement" name="RF9 — Ticket Automático de Suporte — gerado quando IA não resolve a dúvida [Opcional]" id="id-175fc624"/>
    <element xsi:type="archimate:Requirement" name="RF10 — Curadoria de Conhecimento — upload de PDFs via drag &amp; drop indexados [Obrigatório]" id="id-32f60a08"/>
    <element xsi:type="archimate:Requirement" name="RF11 — Gestão de Trilhas — criação/edição com vídeos, textos e missões diárias [Obrigatório]" id="id-f77cbbaf"/>
    <element xsi:type="archimate:Requirement" name="RF12 — Analytics de Engajamento — taxa de conclusão, ofensivas, atrasos [Necessário]" id="id-569b5c09"/>
    <element xsi:type="archimate:Requirement" name="RF13 — Monitoramento de Dúvidas — perguntas frequentes ao mascote (anonimizado) [Opcional]" id="id-73c9d4c1"/>
    <element xsi:type="archimate:Requirement" name="RF14 — Gestão do Laboratório de Ideias — funil de aprovação de sugestões [Opcional]" id="id-e4f182d5"/>
    <element xsi:type="archimate:Requirement" name="RF15 — Administração de Usuários e Permissões — vinculação a unidades/cargos [Obrigatório]" id="id-35b09880"/>
    <element xsi:type="archimate:Principle" name="Somente RH/Admin pode criar, editar e excluir trilhas" id="id-f7cf75c9"/>
    <element xsi:type="archimate:Principle" name="Certificado não é emitido para trilha não concluída" id="id-83035a30"/>
    <element xsi:type="archimate:Principle" name="Nenhum dado pessoal coletado sem consentimento explícito (LGPD)" id="id-69e5a72e"/>
    <element xsi:type="archimate:Principle" name="Mascote responde apenas com base na base de conhecimento indexada" id="id-bfc9f38d"/>
    <element xsi:type="archimate:Principle" name="Conteúdo de treinamento entregue de forma sequencial" id="id-8dd697be"/>
    <element xsi:type="archimate:Constraint" name="App desenvolvido em Android nativo (Kotlin) — RNF7" id="id-1e5993a8"/>
    <element xsi:type="archimate:Constraint" name="Conformidade obrigatória com a LGPD — RNF10" id="id-9a18b308"/>
    <element xsi:type="archimate:Constraint" name="Interface disponível inicialmente apenas em Português (BR) — RNF9" id="id-d0cbde28"/>
    <element xsi:type="archimate:Constraint" name="Compatibilidade com SSO corporativo — RF1" id="id-5a75c459"/>
    <element xsi:type="archimate:Constraint" name="Tempo de carregamento aceitável em redes de velocidade média — RNF2" id="id-f0f429b6"/>
    <element xsi:type="archimate:Constraint" name="Controle de acesso baseado em perfis: Colaborador / RH / Admin — RNF3/RF15" id="id-6370e521"/>
    <element xsi:type="archimate:Goal" name="Disponibilizar acesso a conteúdos e documentos de treinamento/onboarding  de forma digital (copy)" id="id-30ffdb0551694c4386c1f92a6d878746"/>
    <element xsi:type="archimate:Goal" name="Disponibilizar fácil acesso a documentos e a base de conhecimento da empresa" id="id-c533dc3a8c8e49899ef7753a85f9cb74"/>
    <element xsi:type="archimate:Driver" name="Dificuldade de acesso a documentos e políticas corporativas (copy)" id="id-49f2bcc577be4e4abe58f7507fa41e51"/>
    <element xsi:type="archimate:Goal" name="Aumentar a retenção de conhecimento dos colaboradores no período de onboarding" id="id-7a07dcbd87b54f0e8b7236f13c6fa1c1"/>
    <element xsi:type="archimate:Outcome" name="Diminuir o retrabalho durante os treinamentos" id="id-74ff8abfdb0f44ea844070050f3befc9"/>
    <element xsi:type="archimate:Outcome" name="Diminuir o retrabalho e a utilização de papel para impressão de documentos de treinamento" id="id-74a1e67bef6945b5a6411d85060afe60"/>
    <element xsi:type="archimate:Outcome" name="Redução de incidentes de não-conformidade (copy)" id="id-42e90742e9c9406cb24748233ad91b29"/>
    <element xsi:type="archimate:Goal" name="Otimizar o processo de onboarding dos colaboradores" id="id-18d0464e5e674e7189ec6fc2405fbf11"/>
    <element xsi:type="archimate:Outcome" name="Redução de incidentes de não-conformidade" id="id-e20992957a8b4df78ee0f5c555bf9592"/>
    <element xsi:type="archimate:Assessment" name="AGRUPAMENTO DOS PROCESSOS" id="id-9f398db913d1434ca3d4559ba8fb6eaa"/>
  </folder>
